# Copy to webnote.env next to run.sh; it is sourced by the launcher, so keep it
# owner-writable only (run.sh refuses a group/world-writable file).

HOST=0.0.0.0
PORT=8000

# Keep the board across restarts (written 0600, atomically).
#STORE=/var/lib/webnote/notes.json

# HTTPS terminated by the server itself. Set both, or neither.
#TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
#TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
#REDIRECT_HTTP=80

# Needed for a domain name (IP literals are accepted automatically).
#ALLOWED_HOSTS="example.com www.example.com"
#ALLOWED_ORIGINS="https://example.com"

#PYTHON=python3
#LOG=/var/log/webnote.log
#PIDFILE=/run/webnote.pid
